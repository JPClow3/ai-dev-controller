# Linear personal API key (Settings -> Security & access -> Personal API keys)
LINEAR_API_KEY=

# GitHub token with repo + workflow scopes. The controller never merges.
# Leave blank to fall back to the authenticated `gh` CLI identity.

# Orca CLI. Leave as-is if `orca` is on PATH and the desktop app is running.
ORCA_BIN=orca

# Codex CLI. Profiles live in %USERPROFILE%\.codex\config.toml
CODEX_BIN=codex

# Command Code headless CLI. Use a full path only when it is not on PATH.
# Never use bare `cmd`: on Windows that can invoke cmd.exe instead.
COMMAND_CODE_BIN=command-code
# Command Code plan hint (go, goat, pro, max). Not readable headlessly; used by
# the model catalog to flag models above your plan in the TUI.
COMMAND_CODE_PLAN=go

# Z.AI OpenAI-compatible API. Required for zai provider routing.
ZAI_API_KEY=

# Controller
AI_DEV_DB=./data/controller.db
AI_DEV_LOG_LEVEL=info
