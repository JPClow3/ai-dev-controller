# Linear
LINEAR_API_KEY=

# GitHub - needs repo + workflow scopes. The controller never merges.
GITHUB_TOKEN=

# Orca CLI. Leave as-is if `orca` is on PATH.
ORCA_BIN=orca

# Codex CLI (Luna / Terra / Sol)
CODEX_BIN=codex

# Ollama Cloud (GLM / Kimi / DeepSeek)
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=

# Controller
AI_DEV_DB=./data/controller.db
AI_DEV_LOG_LEVEL=info
