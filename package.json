{
  "name": "ai-dev-controller",
  "version": "0.1.0",
  "private": true,
  "description": "Thin deterministic controller for Orca-centered local AI development orchestration",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "ai-dev": "./dist/cli/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx cli/index.ts",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/state/migrate.ts",
    "verify:db": "tsx src/state/verify.ts",
    "verify:schemas": "tsx src/util/validate.smoke.ts"
  },
  "dependencies": {
    "@linear/sdk": "^39.0.0",
    "@octokit/rest": "^21.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
