{
  "name": "ai-dev-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic controller that turns approved Linear issues into dependency-aware Orca worktrees and draft GitHub PRs",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ai-dev": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/state/migrations.ts"
  },
  "dependencies": {
    "@linear/sdk": "^39.0.0",
    "@octokit/rest": "^21.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "execa": "^9.5.2",
    "picocolors": "^1.1.1",
    "simple-git": "^3.27.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
