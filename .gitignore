node_modules/
node_modules.stale/
dist/
*.tsbuildinfo

# Controller state - machine-local, never committed
# `workers/` holds each worker's prompt, launcher and exit sentinel. They live
# here rather than in the repository being worked on, so that a worker cannot
# commit them into its own pull request.
data/workers/
data/*.lock
data/*.db
data/*.db-wal
data/*.db-shm

